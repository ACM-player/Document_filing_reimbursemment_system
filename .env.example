# Local development only. Copy to .env and replace passwords before use.
LABARCHIVE_ENV=development
LABARCHIVE_SECRET_KEY=replace-with-a-long-random-local-secret
LABARCHIVE_DEBUG=true
LABARCHIVE_ALLOWED_HOSTS=127.0.0.1,localhost
LABARCHIVE_CSRF_TRUSTED_ORIGINS=

POSTGRES_DB=labarchive
POSTGRES_USER=labarchive
POSTGRES_PASSWORD=replace-with-a-local-database-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=0

LABARCHIVE_MEDIA_ROOT=media
LABARCHIVE_BACKUP_PATH=.local/backups
LABARCHIVE_MAX_UPLOAD_SIZE=104857600
